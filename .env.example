# ==============================================================================
# pi-odoo-tools Environment Configuration Template
# ==============================================================================
# Configure target environment files inside your scripts/ or workspace directory:
# Example targets: .env_admin_demo, .env_admin, .env_admin_payroll

# --- XML-RPC API Connection (Required for read/write/timesheet/upgrade) ---
ODOO_ADMIN_URL=https://odoo.example.com
ODOO_ADMIN_DB=odoo_db
ODOO_ADMIN_USER=admin
ODOO_ADMIN_SECRET=your_password_or_api_key

# --- Timesheet User Attribution (Optional) ---
# If authenticated as admin or service user, timesheet entries will be resolved
# and attributed to this engineer profile instead of generic Administrator.
ODOO_TIMESHEET_USER_EMAIL=engineer@example.com
ODOO_TIMESHEET_USER_NAME=Engineer Name

# --- Remote Host & SSH Deployment (Optional, for CLI Upgrade & Git Deploy) ---
ODOO_SSH_HOST=192.168.1.50
ODOO_SSH_USER=ubuntu
ODOO_SSH_PASS=your_ssh_password
ODOO_ADDONS_PATH=/home/ubuntu/odoo/addons
ODOO_HEALTH_URL=https://odoo.example.com/web/health

# --- Container / Swarm Runtime Options ---
# For Docker Compose:
ODOO_CONTAINER=odoo18
ODOO_RESTART_CMD=docker restart odoo18
ODOO_DB_HOST=postgres
ODOO_DB_PORT=5432
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=your_db_password

# For Docker Swarm (Production mode):
# ODOO_IS_SWARM=true
# ODOO_SWARM_SERVICE=odoo_service
# ODOO_CONTAINER_PATTERN=odoo_service.1
# ODOO_RESTART_CMD=docker service update --force odoo_service

# --- GitLab Integration (Optional, for remote git pull deploy) ---
# Place in .env_gitlab:
# GITLAB_API_URL=https://gitlab.example.com/api/v4
# GITLAB_PERSONAL_ACCESS_TOKEN=glpat-your-token
# GITLAB_PROJECT_GROUP=odoo-addons
